{
  "test_projects": [
    {
      "name": "juxt-site (main)",
      "framework": "clojure.test + kaocha",
      "run_command": "make test",
      "ci_commands": [
        "clojure -M:test -m kaocha.runner --reporter kaocha.report/dots",
        "./bin/kaocha :test --plugin kaocha.plugin/junit-xml --junit-xml-file test-results/kaocha/results.xml",
        "clojure -M:test -m kaocha.runner"
      ],
      "side_effects": [
        "XTDB in-memory database creation during test setup (with-xt fixture)",
        "Database writes via submit-and-await! (xtdb.api/put transactions)",
        "HTTP request/response handler invocations (with-handler fixture)"
      ],
      "setup": [
        "Clojure CLI (tools.deps) installed",
        "OpenJDK 11+ (CircleCI uses openjdk-11, Docker uses openjdk-17)",
        "Maven cache (~/.m2/repository, ~/.gitlibs, ~/.deps.clj)",
        "No external services required - XTDB uses in-memory RocksDB by default",
        "Test paths: test/"
      ]
    },
