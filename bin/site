(ns site
  (:require
   [babashka.curl :as curl]
   [babashka.deps :as deps]
   [clojure.tools.cli :refer [parse-opts]]
   [clojure.java.io :as io]
   [clojure.java.shell :as sh]
   [cheshire.core :as json]
   [clojure.pprint :refer [pprint]]
   [clojure.edn :as edn]
   [clojure.string :as str])
  (:import
   (java.nio.file Files)
   (java.nio.file.attribute FileAttribute)))

(deps/add-deps '{:deps {io.aviso/pretty {:mvn/version "1.1"}}})

(require '[io.aviso.ansi :as ansi])

(def ^:dynamic *debug* nil)

(defn edn-to-json
  [edn]
  (-> (edn/read-string {:readers {'juxt.site.alpha/as-str pr-str}} edn)
      (json/encode)))

(defn error! [& msg]
  (apply println (apply str ansi/red-font "fail:" ansi/reset-font) msg))

(defn error-and-exit! [exit & msg]
  (apply error! msg)
  (System/exit exit))

(defn error-and-usage! [msg opts]
  (error! msg)
  (println "Usage:")
  (println (:summary opts))
  (System/exit 1))

(defn message! [& msg]
  (apply println (apply str ansi/bold-green-font "site:" ansi/reset-font) msg))

(def default-config-file
  (str (System/getProperty "user.home") "/.config/site/config.edn"))

(defn confirm-operation
  [msg]
  (print (str msg " (y/n) "))
  (flush)
  (let [yn (read-line)]
    (if (re-matches #"y|yes" yn)
      true
      (error-and-exit! 1 "Operation cancelled"))))

(defn parse-config
  [path]
  (let [site-base-uri (System/getenv "SITE_BASE_URI")
        site-username (System/getenv "SITE_USERNAME")
        site-password (System/getenv "SITE_PASSWORD")]
    (when-not site-username (error-and-exit! 1 "SITE_USERNAME required"))
    (when-not site-password (error-and-exit! 1 "SITE_PASSWORD required"))
    (when-not site-base-uri (error-and-exit! 1 "SITE_BASE_URI required"))
    {:site-base-uri site-base-uri
     :site-username site-username
     :site-password site-password}))

(defn show-config
  "Show configuration"
  [config opts]
  (pprint config))

(defn list-users
  "List users"
  [{:keys [site-base-uri site-username site-password]} _opts]
  (let [{:keys [status headers body]}
        (curl/get
         (format "%s/_site/users/" site-base-uri)
         {:headers {"accept" "application/json"}
          :basic-auth [site-username site-password]
          :throw false})]
    (cond
      (= (quot status 100) 2)
      (println (json/encode (json/decode body) {:pretty true}))

      :else
      (do
        (error! "Server response: " status " " (str/trim body))
        (message! "Request id: " (get headers "site-request-id"))))))

(defn reset-password
  "Reset a user's password"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [username password]} (:options opts)]

    (confirm-operation (str "Reset password for user " username))

    (when-not username (error-and-usage! "Username required" opts))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/users/%s/password" site-base-uri username)
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (json/generate-string
                   {"type" "Password"
                    "user" (format "%s/_site/users/%s" site-base-uri username)
                    "password" password})
            :throw false})]
      (cond
        (= status 401)
        (error! "Server response: " status " " (str/trim body))

        (= (quot status 100) 2)
        (message! "Password reset for" username)

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn put-user
  "Create or update a user"
  [{:keys [site-username site-password site-base-uri] :as config} opts]
  (let [{:keys [username name email]} (:options opts)]

    (confirm-operation (str "Create or update user " username))

    (when-not username (error-and-usage! "Username required" opts))
    (when-not name (error-and-usage! "Name required" opts))
    (when-not email (error-and-usage! "Email required" opts))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/users/%s" site-base-uri username)
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (json/generate-string
                   {"type" "User"
                    ;;"username" username
                    "name" name
                    "email" email})
            :throw false})]
      (cond
        (= status 401)
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Is your access-token valid?")
          (message! "To get a new access token, use the get-token sub-command")
          (message! "Request id: " (get headers "site-request-id")))

        (= status 201)
        (message! "User created:" (format "%s (Welcome %s!)" username name))

        (= status 204)
        (message! "User updated:" username)

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id"))))

      (when (#{201 204} status)
        (reset-password config opts)))))

(defn put-role
  "Create or update a role"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [role description]} (:options opts)]

    (confirm-operation (str "Create or update role" role))

    (when-not role (error-and-usage! "Role required" opts))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/roles/%s" site-base-uri role)
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (json/generate-string
                   (cond-> {"type" "Role"
                            "name" role}
                     description (assoc "description" description)))

            :throw false})]
      (cond
        (= status 401)
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Is your access-token valid?")
          (message! "To get a new access token, use the get-token sub-command")
          (message! "Request id: " (get headers "site-request-id")))

        (= status 201)
        (message! "Role created:" role)

        (= status 204)
        (message! "Role updated:" role)

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn list-roles
  "List roles"
  [{:keys [site-username site-password site-base-uri]} _opts]
  (let [{:keys [status headers body]}
        (curl/get
         (format "%s/_site/roles/" site-base-uri)
         {:headers {"accept" "application/json"}
          :basic-auth [site-username site-password]
          :throw false})]
    (cond
      (= (quot status 100) 2)
      (println (json/encode (json/decode body) {:pretty true}))

      :else
      (do
        (error! "Server response: " status " " (str/trim body))
        (message! "Request id: " (get headers "site-request-id"))))))

(defn assign-role
  "Assign a role to a user"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [username role justification]} (:options opts)]

    (confirm-operation (str "Assign role " role " to user " username))

    (when-not username (error-and-usage! "Username required" opts))
    (when-not role (error-and-usage! "Role required" opts))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/roles/%s/users/%s" site-base-uri role username)
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (json/generate-string
                   (cond-> {"type" "UserRoleMapping"
                            "assignee" (format "%s/_site/users/%s" site-base-uri username)
                            "assigner" (format "%s/_site/users/%s" site-base-uri site-username)
                            "role" (format "%s/_site/roles/%s" site-base-uri role)}
                     justification (assoc "businessJustification" justification)))
            :throw false})]
      (cond
        (= status 401)
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Is your access-token valid?")
          (message! "To get a new access token, use the get-token sub-command")
          (message! "Request id: " (get headers "site-request-id")))

        (= status 201)
        (message! "Assignment created:" username "assigned role of" role)

        (= status 204)
        (message! "Assignment updated:" username "re-assigned role of" role)

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn put-rule
  "Put a rule"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [name rule]} (:options opts)]

    (confirm-operation (str "Create or update rule " name))

    (when-not name (error-and-usage! "Name required" opts))
    (when-not rule (error-and-usage! "Rule required" opts))
    (when-not (.isFile (io/file rule)) (error-and-exit! 1 "Rule file must be a file"))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/rules/%s" site-base-uri name)
           {:headers { "content-type" "application/json"} 
            :basic-auth [site-username site-password]
            :body (cond-> (slurp (io/file rule))
                    :always (str/replace "{{base-uri}}" site-base-uri)
                    (re-matches #".*\.edn$" rule) edn-to-json)
            :throw false})]
      (cond
        (= status 201)
        (message! (format "Rule created: %s" (get headers "location")))

        (= status 204)
        (message! (format "Rule updated: %s" (get headers "location")))

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn put-trigger
  "Put a trigger"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [name trigger]} (:options opts)]

    (confirm-operation (str "Create or update trigger " name))

    (when-not name (error-and-usage! "Name required" opts))
    (when-not trigger (error-and-usage! "Trigger file required" opts))
    (when-not (.isFile (io/file trigger)) (error-and-exit! 1 "Trigger file must be a file"))

    (let [{:keys [status headers body]}
          (curl/put
           (format "%s/_site/triggers/%s" site-base-uri name)
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (cond-> (slurp (io/file trigger))
                    site-base-uri (str/replace "{{base-uri}}" site-base-uri)
                    (re-matches #".*\.edn$" trigger)
                    edn-to-json)
            :throw false})]
      (cond
        (= status 201)
        (message! (format "Trigger created: %s" (get headers "location")))

        (= status 204)
        (message! (format "Trigger updated: %s" (get headers "location")))

        :else
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn put-api
  "Upload and install an API"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [name openapi]} (:options opts)
        _ (when-not name (error-and-usage! "API name required" opts))
        _ (when-not (re-matches #"[a-z]{2,}" name)
            (error-and-usage! "Name must match pattern: [a-z]{2,}" opts))

        _ (when-not openapi (error-and-usage! "OpenAPI file required" opts))
        _ (when-not (.exists (io/file openapi)) (error-and-exit! 1 "OpenAPI file not found"))
        _ (when-not (.isFile (io/file openapi)) (error-and-exit! 1 "OpenAPI argument is not a file"))

        _ (confirm-operation (str "Upload and install API " name))

        openapi-doc (edn/read-string
                     {:readers {'juxt.site.alpha/as-str pr-str}}
                     (slurp (io/file openapi)))

        {:keys [status headers body]}
        (curl/put
         (format "%s/_site/apis/%s/openapi.json" site-base-uri name)
         {:headers {"content-type" "application/vnd.oai.openapi+json;version=3.0.2"}
          :basic-auth [site-username site-password]
          :body (json/generate-string
                 {"type" "OpenAPI"
                  "openapi" openapi-doc})
          :throw true})]
    (cond
      (#{201 204} status)
      (message! (format "API %s: %s (version %s)"
                        (case status 201 "installed" 204 "updated")
                        (get-in openapi-doc [:info :title])
                        (get-in openapi-doc [:info :version])))

      :else
      (do
        (error! "Server response: " status " " (str/trim body))
        (message! "Request id: " (get headers "site-request-id"))))))

(defn sh [& args]
  (let [{:keys [exit err]} (apply sh/sh args)]
    (when (pos? exit)
      (error! err))))

(defn create-tmp-dir []
  (let [tmpdir (Files/createTempDirectory
                "site-" (into-array FileAttribute []))]
    (message! "Created tmp dir: " (.toString tmpdir))
    tmpdir))

(defn content-type [filename]
  (when-let [[_ suffix] (re-matches #"[^\.]+(\..*)" filename)]
    (or
     (get {".js" "application/javascript"
           ".json" "application/json"
           ".js.map" "application/json"
           ".css.map" "application/json"
           ".css" "text/css"
           ".html" "text/html"
           ".png" "image/png"} suffix)
     (error-and-exit! 1 "Failed to determine content-type for" filename (format "(suffix=%s)" suffix)))))

(defn post-resources
  "Post one or more resources"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [file]} (:options opts)] 

    (when-not (.exists (io/file file)) (error-and-exit! 1 (str "File not found: " file)))

    (confirm-operation (str "Post resources from file " file))

    (let [{:keys [status headers body]}
          (curl/post
           (str site-base-uri "/_site/resources/")
           {:headers {"content-type" "application/edn"}
            :basic-auth [site-username site-password]
            :body (-> (slurp (io/file file))
                      (str/replace "{{base-uri}}" site-base-uri))
            :throw false})]
      (case status
        (201 204)
        (message! (format "Resource %s: %s"
                          (case status 201 "created" 204 "updated")
                          (get headers "location")))

        207
        (let [results (edn/read-string body)
              errors (filter #(contains? % :error) results)]
          (if (pos? (count errors))
            (do
              (error! (format "Not all resources were accepted:"))
              (dorun (map (fn [ix r]
                            (cond
                              (< (:status r) 400)
                              (println (format "%s%d: %s%s" ansi/green-font ix r ansi/reset-font))
                              :else
                              (println (format "%s%d: %s%s" ansi/red-font ix r ansi/reset-font))))
                          (range) results)))
            (message! (format "Resources all posted OK"))))

        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn post-json
  "Post JSON to a resource"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [file url]} (:options opts)] 

    (when-not file (error-and-exit! 1 "File required"))
    (when-not (.exists (io/file file)) (error-and-exit! 1 (str "File not found: " file)))
    (when-not url (error-and-exit! 1 "URL is required"))

    (confirm-operation (str "Post JSON from file " file " to " url))

    (let [url (str/replace url "{{base-uri}}" site-base-uri)
          {:keys [status headers body]}
          (curl/post
           url
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (cond-> (slurp (io/file file))
                    :always (str/replace "{{base-uri}}" site-base-uri)
                    (.endsWith file ".edn") (edn-to-json))
            :throw false})]
      (case status
        (201 204)
        (message! (format "Resource %s: %s"
                          (case status 201 "created" 204 "updated")
                          (get headers "location")))
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(defn put-json
  "PUT JSON to a resource"
  [{:keys [site-username site-password site-base-uri]} opts]
  (let [{:keys [file url]} (:options opts)] 

    (when-not file (error-and-exit! 1 "File required"))
    (when-not (.exists (io/file file)) (error-and-exit! 1 (str "File not found: " file)))

    (let [embedded-url (when (.endsWith file ".edn")
                         (:xt/id (edn/read-string (slurp file))))

          _ (when (and embedded-url url) (error-and-exit! 1 "Should not specify URL both in the document and as an option"))

          url (or embedded-url url)

          _ (when-not url (error-and-exit! 1 "Failed to specify identity (URI), either in the document (xt/id) or as an option"))

          url (str/replace url "{{base-uri}}" site-base-uri)
          {:keys [status headers body]}
          (curl/put
           url
           {:headers {"content-type" "application/json"}
            :basic-auth [site-username site-password]
            :body (cond-> (slurp (io/file file))
                    :always (str/replace "{{base-uri}}" site-base-uri)
                    (.endsWith file ".edn") (edn-to-json))
            :throw false})]
      (case status
        (201 204)
        (message! (format "Resource %s: %s"
                          (case status 201 "created" 204 "updated")
                          (get headers "location")))
        (do
          (error! "Server response: " status " " (str/trim body))
          (message! "Request id: " (get headers "site-request-id")))))))

(def cli-options
  [["-b" "--base-uri BASE-URI" "The Base-URI of the server you are targetting"]
   ["-s" "--silent" "Silent mode"]
   ["-d" "--debug" "Enable debug mode"]
   ["-v" "--verbose" "Verbose mode"]
   ["-h" "--help" "Show this summary"]
   [nil "--config CONFIG" "Path to config file"]])

(def commands
  [["config"
    {:description (:doc (meta #'show-config))
     :cli-options []
     :delegate show-config}]

   ["list-users"
    {:description (:doc (meta #'list-users))
     :cli-options []
     :delegate list-users}]

   ["put-user"
    {:description (:doc (meta #'put-user))
     :cli-options [["-n" "--name NAME" "The user's name"]
                   ["-u" "--username USERNAME" "The username of the user you are creating/updating"]
                   ["-p" "--password PASSWORD" "A temporary password for the user"]
                   ["-e" "--email EMAIL" "The user's email"]]
     :delegate put-user}]

   ["reset-password"
    {:description (:doc (meta #'reset-password))

     :cli-options [["-u" "--username USERNAME" "The username of the user"]
                   ["-p" "--password PASSWORD" "A temporary password for the user"]]
     :delegate reset-password}]

   ["put-role"
    {:description (:doc (meta #'put-role))
     :cli-options [["-r" "--role ROLE" "The role you are creating/updating"]
                   ["-d" "--description DESCRIPTION" "An optional description"]]
     :delegate put-role}]

   ["list-roles"
    {:description (:doc (meta #'list-roles))
     :cli-options []
     :delegate list-roles}]

   ["assign-role"
    {:description (:doc (meta #'assign-role))
     :cli-options [["-u" "--username USERNAME" "The user receiving the role"]
                   ["-r" "--role ROLE" "The role you are assigning"]
                   ["-j" "--justification JUSTIFICATION" "The business justification"]]
     :delegate assign-role}]

   ["put-rule"
    {:description (:doc (meta #'put-rule))
     :cli-options [["-n" "--name NAME" "Rule name"]
                   ["-r" "--rule FILE" "Rule file"]]
     :delegate put-rule}]

   ["put-trigger"
    {:description (:doc (meta #'put-trigger))
     :cli-options [["-n" "--name NAME" "Trigger name"]
                   ["-t" "--trigger FILE" "Trigger file"]]
     :delegate put-trigger}]

   ["put-api"
    {:description (:doc (meta #'put-api))
     :cli-options [["-n" "--name NAME" "API name"]
                   ["-f" "--openapi FILE" "OpenAPI description file"]]
     :delegate put-api}]

   ["post-resources"
    {:description (:doc (meta #'post-resources))
     :cli-options [["-f" "--file FILE" "Resource file (in EDN format)"]]
     :delegate post-resources}]

   ["post-json"
    {:description (:doc (meta #'post-json))
     :cli-options [["-f" "--file FILE" "File containing data"]
                   ["-u" "--url URL" "URL to POST to"]]
     :delegate post-json}]

   ["put-json"
    {:description (:doc (meta #'put-json))
     :cli-options [["-f" "--file FILE" "File containing data"]
                   ["-u" "--url URL" "URL to POST to"]]
     :delegate put-json}]])

(defn print-help
  [{:keys [summary]}]
  (println (str ansi/bold-green-font "site" ansi/reset-font))
  (println)
  (println "This is a resource management tool for Site.")
  (println)
  (println (str ansi/white-font "Usage" ansi/reset-font))
  (println)
  (println "site <global-options> <subcommand> <subcommand-options>")
  (println)
  (println (str ansi/white-font "Global options" ansi/reset-font))
  (println summary)
  (println)
  (println (str ansi/white-font "Environment variables" ansi/reset-font))
  (println)
  (println "SITE_BASE_URI \tSet the default Base-URI")
  (println "SITE_PASS_DIR \tOverride where Unix pass passwords are located")
  (println)
  (println (str ansi/white-font "Subcommands" ansi/reset-font))
  (println)
  (doseq [[command {:keys [description cli-options delegate]}] commands]
    (apply
     println
     (remove nil? [command (str ansi/yellow-font "(" description (when-not delegate " - coming soon!") ")" ansi/reset-font)]))
    (when-let [summary (:summary (parse-opts [] cli-options))]
      (when-not (str/blank? (str/trim summary))
        (println summary)))
    (println)))

(let [{:keys [options arguments errors] :as global-parsed-opts}
      (parse-opts *command-line-args* cli-options :in-order true)
      command (first arguments)
      {:keys [cli-options delegate] :as command-opts} ((into {} commands) command)
      config (parse-config (or (:config options) default-config-file))]

  (cond
    (contains? options :help)
    (print-help global-parsed-opts)

    errors
    (doseq [err errors]
      (println err))

    command-opts
    (binding [*debug* (:debug options)]
      (if delegate
        (delegate
         config
         (-> (parse-opts (next arguments) cli-options)
             (update :options merge options)))
        (println "No implementation:" command)))

    (first arguments)
    (println "Unknown command:" (first arguments))

    :else
    (print-help global-parsed-opts)))

